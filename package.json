{
  "name": "matrimony-microservice",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.7.0",
  "description": "Turborepo monorepo running 3 frontends (Girija-Kalyana, Sangam-sathi, Shree-ganda) and matrimony-service backend concurrently",
  "workspaces": [
    "apps/*",
    "backend/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=girija-kalyana --filter=sangam-sathi --filter=shree-ganda --filter=matrimony-service",
    "dev:all": "turbo run dev",
    "dev:concurrently": "concurrently -k -n \"girija,sangam,shree,matrimony\" -c \"cyan,magenta,yellow,green\" \"npm run dev --workspace=girija-kalyana\" \"npm run dev --workspace=sangam-sathi\" \"npm run dev --workspace=shree-ganda\" \"npm run dev --workspace=matrimony-service\"",
    "build": "turbo run build",
    "build:workspaces": "npm run build --workspaces --if-present",
    "build:girija": "npm run build --workspace=girija-kalyana",
    "build:sangam": "npm run build --workspace=sangam-sathi",
    "build:shree": "npm run build --workspace=shree-ganda",
    "deploy": "turbo run deploy",
    "deploy:girija": "npm run deploy --workspace=girija-kalyana",
    "deploy:sangam": "npm run deploy --workspace=sangam-sathi",
    "deploy:shree": "npm run deploy --workspace=shree-ganda",
    "deploy:matrimony": "npm run deploy --workspace=matrimony-service",
    "deploy:shree-server": "npm run deploy --workspace=shree-gandha-server",
    "dev:girija": "npm run dev --workspace=girija-kalyana",
    "dev:sangam": "npm run dev --workspace=sangam-sathi",
    "dev:shree": "npm run dev --workspace=shree-ganda",
    "dev:backend": "npm run dev --workspace=matrimony-service",
    "dev:matrimony": "npm run dev --workspace=matrimony-service"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "turbo": "^2.11.8"
  }
}

